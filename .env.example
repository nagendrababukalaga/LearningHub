# LearningHub Environment Configuration Example

# Django Secret Key
SECRET_KEY=django-insecure-learninghub-hackathon-2026-production-key-seed-xyz

# Debug Mode (set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional External AI API Key (Leave empty to use the built-in offline intelligent educational generator)
OPENAI_API_KEY=
