# ================================================================
# LearningHub Environment Configuration Example
# Copy this file to .env for local development overrides.
# ================================================================

# Django Secret Key (Generate a random 50+ char string for production)
SECRET_KEY=django-insecure-learninghub-hackathon-2026-production-key-seed-xyz

# Debug Mode (Set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated domains)
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF Trusted Origins (comma-separated full URLs with scheme)
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Database URL (Leave empty to use local SQLite db.sqlite3, or provide PostgreSQL connection string)
# Example: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=

# Seed Database Flag (Set to true to seed curriculum data during build/deployment)
SEED_DATABASE=false

# Optional External AI API Key (Leave empty to use the built-in educational generator)
AI_API_KEY=
AI_PROVIDER=fallback
